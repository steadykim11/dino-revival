# 디노 리바이벌 환경변수 템플릿
#
# 이 파일을 .env.local로 복사한 뒤 각 값을 채우세요.
# 절대 .env.local을 커밋하지 마세요.

# ─────────────────────────────────────────────
# Supabase (Postgres)
# ─────────────────────────────────────────────
# Supabase Pooler (port 6543, pgbouncer=true) — 앱 런타임이 사용
DATABASE_URL=
# Supabase Direct (port 5432) — Prisma 마이그레이션이 사용
DIRECT_URL=

# 브라우저에 노출되는 키 (NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────
# 외부 API
# ─────────────────────────────────────────────
# 공공데이터포털에서 발급. KPX_D1·D2 API에 활용신청 필요.
# 수집 작업(pnpm job:collect)을 돌리는 기기에만 필요. Vercel에는 넣지 않아도 된다.
KPX_API_KEY=

# ─────────────────────────────────────────────
# 관리자 (시연 컨트롤)
# ─────────────────────────────────────────────
# 콤마 구분 UUID 목록. 본인 사용자 ID를 D8 가입 후 여기에 추가.
ADMIN_USER_IDS=
