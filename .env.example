# 디노 리바이벌 환경변수 템플릿
#
# 이 파일을 .env.local로 복사한 뒤 각 값을 채우세요.
# 절대 .env.local을 커밋하지 마세요.

# ─────────────────────────────────────────────
# Supabase (Postgres)
# ─────────────────────────────────────────────
# Supabase Pooler (port 6543, pgbouncer=true) — 앱 런타임이 사용
DATABASE_URL=
# Supabase Direct (port 5432) — Prisma 마이그레이션이 사용
DIRECT_URL=

# 브라우저에 노출되는 키 (NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버에서만 사용. 누출 시 즉시 재발급.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# 외부 API
# ─────────────────────────────────────────────
# 공공데이터포털에서 발급. KPX_D1·D2 API에 활용신청 필요.
KPX_API_KEY=

# ─────────────────────────────────────────────
# Cron / Ingest 인증
# ─────────────────────────────────────────────
# Vercel Cron과 외부 ingest 호출이 사용하는 공유 비밀.
# 충분히 긴 랜덤 문자열 (예: openssl rand -hex 32).
CRON_SECRET=

# 본인 PC의 PS 루프가 호출할 Vercel ingest 엔드포인트의 전체 URL.
# 예: https://dino-revival.vercel.app/api/ingest/world-snapshot
VERCEL_INGEST_URL=

# ─────────────────────────────────────────────
# 관리자 (시연 컨트롤)
# ─────────────────────────────────────────────
# 콤마 구분 UUID 목록. 본인 사용자 ID를 D8 가입 후 여기에 추가.
ADMIN_USER_IDS=
