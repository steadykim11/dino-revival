// =============================================================================
// Generator & Datasource
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Enums
// =============================================================================

enum DinoSpecies {
  TYRANNO    // 티라노 계열 (MVP 유일)
  BRACHIO    // 용각류 (Phase 2)
  TRICERA    // 각룡류 (Phase 2)
}

enum DinoStage {
  EGG         // 알
  HATCHLING   // 유년기
  ADULT       // 성체
}

enum MissionType {
  DAILY       // 일반 일일 미션
  DUNGEON     // 던전 미션
}

enum MissionTimeSlot {
  DAY         // 낮 (10:00~18:00)
  EVENING     // 저녁 (18:00~24:00)
  ANYTIME     // 종일
}

enum DungeonTriggerReason {
  auto        // 예비율 기준 자동 발령
  manual      // 관리자 수동 발령
}

enum MissionCategory {
  COOLING     // 냉방
  HEATING     // 난방
  LIGHTING    // 조명
  STANDBY     // 대기전력
  LAUNDRY     // 세탁
  KITCHEN     // 주방
  ETC         // 기타
}

// =============================================================================
// 1. User — 사용자 프로필
// =============================================================================

model User {
  /// Supabase auth.users.id 와 동일한 UUID
  id                String   @id @db.Uuid

  /// 닉네임 (2~12자, 시스템 내 고유)
  nickname          String   @unique @db.VarChar(12)

  /// 행정안전부 표준 시·군·구 코드 (5자리, 예: "11680" = 강남구)
  regionCode        String   @db.VarChar(5)

  /// 더미 사용자 여부 (시드 데이터 식별용)
  isDummy           Boolean  @default(false)

  /// 닉네임 마지막 변경 시각 (변경 주기 제한용)
  nicknameChangedAt DateTime?
  /// 동네 마지막 변경 시각
  regionChangedAt   DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  guildId           String?  @db.Uuid
  guild             Guild?   @relation(fields: [guildId], references: [id], onDelete: SetNull)
  dino              Dino?
  missions          Mission[]
  missionLogs       MissionLog[]

  @@index([regionCode])
  @@index([guildId])
  @@index([isDummy])
  @@map("users")
}

// =============================================================================
// 2. Dino — 사용자별 공룡 (1:1)
// =============================================================================

model Dino {
  id                String      @id @default(uuid()) @db.Uuid

  userId            String      @unique @db.Uuid
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 사용자가 알 받을 때 지어준 이름 (2~12자)
  name              String      @db.VarChar(12)

  species           DinoSpecies @default(TYRANNO)
  stage             DinoStage   @default(EGG)

  /// 누적 클린에너지 (진화 임계값 비교 기준)
  totalCleanEnergy  Int         @default(0)

  /// 친밀도 (0~100, 애플리케이션 레이어에서 cap)
  intimacy          Int         @default(0)

  /// 누적 CO2 감축량 (kg, 통계용)
  totalCo2Reduced   Decimal     @default(0) @db.Decimal(10, 3)

  /// EGG → HATCHLING 진화 시각 (NULL이면 아직 알)
  hatchedAt         DateTime?

  /// HATCHLING → ADULT 진화 시각
  evolvedAt         DateTime?

  updatedAt         DateTime    @updatedAt

  @@map("dinos")
}

// =============================================================================
// 3. Guild — 동네 단위 길드
// =============================================================================

model Guild {
  id                String   @id @default(uuid()) @db.Uuid

  /// 시·군·구 코드 (User.regionCode와 매칭)
  regionCode        String   @unique @db.VarChar(5)

  /// 표시명 (예: "강남구")
  displayName       String   @db.VarChar(50)

  createdAt         DateTime @default(now())

  // 길드 점수는 저장하지 않는다 — MissionLog.guildId 기준으로 시즌(KST 월)·누적
  // cleanEnergyEarned 합을 조회 시 계산 (lib/guilds/score.server.ts, ADR 43)

  // Relations
  members           User[]
  missionLogs       MissionLog[]

  @@map("guilds")
}

// =============================================================================
// 4. MissionPool — 미션 마스터 데이터
// =============================================================================

model MissionPool {
  id                String           @id @default(uuid()) @db.Uuid

  /// 미션 제목 (예: "에어컨 1℃ 올리기")
  title             String           @db.VarChar(100)

  /// 상세 설명·수행 가이드
  description       String           @db.Text

  category          MissionCategory
  timeSlot          MissionTimeSlot

  /// 기본 보상 클린에너지
  baseReward        Int

  /// 추정 절감량 (kWh, CO₂ 계산용)
  estimatedKwh      Decimal          @db.Decimal(6, 3)

  /// 활성화 여부 (운영 중 풀에서 제외 가능)
  isActive          Boolean          @default(true)

  createdAt         DateTime         @default(now())

  // Relations
  missions          Mission[]

  @@index([category])
  @@index([timeSlot])
  @@index([isActive])
  @@map("mission_pool")
}

// =============================================================================
// 5. Mission — 사용자별 일일 미션 인스턴스
// =============================================================================

model Mission {
  id                String       @id @default(uuid()) @db.Uuid

  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  poolId            String       @db.Uuid
  pool              MissionPool  @relation(fields: [poolId], references: [id])

  type              MissionType  @default(DAILY)

  /// 던전 미션인 경우 던전 ID 참조
  dungeonId         String?      @db.Uuid
  dungeon           Dungeon?     @relation(fields: [dungeonId], references: [id], onDelete: SetNull)

  /// 일일 미션의 슬롯 (0=DAY, 1=EVENING, 2=ANYTIME). 던전 미션은 NULL.
  /// (userId, assignedDate, type, slot) 유니크로 같은 날 중복 발급을 막는다.
  slot              Int?         @db.SmallInt

  /// 할당일 (자정 기준, 인덱스용)
  assignedDate      DateTime     @db.Date

  /// 만료 시각 (당일 자정+1)
  expiresAt         DateTime

  /// 완료 시각 (NULL이면 미완료)
  completedAt       DateTime?

  createdAt         DateTime     @default(now())

  /// 완료 기록 (완료 전이면 없음)
  log               MissionLog?

  @@unique([userId, assignedDate, type, slot])
  /// 같은 던전의 같은 미션을 한 사용자에게 두 번 발급하지 않는다
  @@unique([userId, dungeonId, poolId])
  @@index([userId, assignedDate])
  @@index([userId, completedAt])
  @@index([dungeonId])
  @@index([expiresAt])
  @@map("missions")
}

// =============================================================================
// 6. MissionLog — 미션 완료 영구 이력
// =============================================================================

model MissionLog {
  id                          String       @id @default(uuid()) @db.Uuid

  userId                      String       @db.Uuid
  user                        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 완료한 Mission. 미션 행이 삭제되면 NULL (기록은 남는다). 시드 더미 로그도 NULL.
  /// 유니크 — 한 미션은 한 번만 완료 기록된다.
  missionId                   String?      @unique @db.Uuid
  mission                     Mission?     @relation(fields: [missionId], references: [id], onDelete: SetNull)

  /// 던전 미션이면 해당 던전 (기여도 집계용)
  dungeonId                   String?      @db.Uuid
  dungeon                     Dungeon?     @relation(fields: [dungeonId], references: [id], onDelete: SetNull)

  /// 완료 당시 소속 길드 (시즌 점수 집계용, ADR 43). 길드를 옮겨도 이 기록의 점수는 원래 길드에 남는다.
  /// 길드가 없던 사용자이거나 길드가 삭제되면 NULL.
  guildId                     String?      @db.Uuid
  guild                       Guild?       @relation(fields: [guildId], references: [id], onDelete: SetNull)

  /// 완료 당시 미션 정보 스냅샷
  missionTitle                String       @db.VarChar(100)
  missionType                 MissionType
  missionCategory             MissionCategory

  /// 완료 시점 탄소강도 (gCO₂/kWh, 감사용)
  carbonIntensityAtCompletion Decimal?     @db.Decimal(6, 2)

  /// 지급 보상
  cleanEnergyEarned           Int
  co2ReducedKg                Decimal      @db.Decimal(10, 3)
  intimacyEarned              Int

  completedAt                 DateTime     @default(now())

  /// stageBefore != stageAfter 이면 이 미션 완료로 진화 발생
  /// battle 페이지가 두 값을 비교해 evolution phase 트리거
  stageBefore                 DinoStage
  stageAfter                  DinoStage

  @@index([userId, completedAt])
  @@index([dungeonId])
  @@index([guildId, completedAt])
  @@map("mission_logs")
}

// =============================================================================
// 7. Dungeon — 던전 활성화 인스턴스
// =============================================================================

model Dungeon {
  id                     String       @id @default(uuid()) @db.Uuid

  /// 트리거 사유
  triggerReason          DungeonTriggerReason

  /// 활성화 여부. 활성 던전은 동시에 하나만 — 부분 유니크 인덱스
  /// dungeons_single_active (마이그레이션 SQL에만 있음, Prisma 스키마로 표현 불가)
  isActive               Boolean      @default(true)

  activatedAt            DateTime     @default(now())
  expiresAt              DateTime
  endedAt                DateTime?

  /// 발령 시점 예비율 (트리거 근거, 감사용)
  triggerReserveRate     Decimal?     @db.Decimal(5, 2)

  /// 발령 시점 탄소강도
  triggerCarbonIntensity Decimal?     @db.Decimal(6, 2)

  // Relations
  missions               Mission[]
  missionLogs            MissionLog[]

  @@index([isActive])
  @@index([expiresAt])
  @@map("dungeons")
}

// =============================================================================
// 8. WorldSnapshot — 세계 상태 시계열 (KPX 5분 단위 값을 20분마다 수집)
// =============================================================================

model WorldSnapshot {
  /// 5분 단위 타임스탬프 (PK 겸 정렬키)
  ts                     DateTime  @id @db.Timestamptz

  /// 탄소강도 (gCO₂/kWh)
  carbonIntensity        Decimal   @db.Decimal(6, 2)

  /// 전력 공급예비율 (%)
  supplyReserveRate      Decimal   @db.Decimal(5, 2)

  /// 공급능력 (MW)
  supplyCapacity         Int

  /// 현재부하 (MW)
  currentLoad            Int

  /// 당일 최대 예측 수요 (MW, KPX D1 forecastLoad). 이 컬럼을 추가하기 전 행은 NULL (ADR 42)
  forecastLoad           Int?

  /// 발전믹스 (12개 발전원 MW, JSON). 키는 lib/world/fuel-mix.ts의 FuelMixSchema
  fuelMix                Json

  createdAt              DateTime  @default(now())

  @@map("world_snapshots")
}

